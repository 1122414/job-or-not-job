extends SceneTree
var failures := 0
func _initialize() -> void: call_deferred("run")
func check(value: bool,message: String) -> void:
	if not value: push_error(message); failures+=1
func run() -> void:
	var game=load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	root.set_disable_input(true)
	Input.mouse_mode=Input.MOUSE_MODE_VISIBLE
	await physics_frame
	var flow: RecruitmentFlow=game.recruitment
	for action in ["interview_hr","interview_lead","interview_boss","interview_b"]: flow.finish(action)
	check(game.career.employer=="" and flow.applications.a.phase=="waiting" and flow.applications.b.phase=="waiting","两家公司可同时等反馈，不能面试后入职")
	flow.handle("join_a")
	check(game.career.employer=="" and flow.reserved()=="","旧入职动作不能绕过通知")
	var before: Dictionary=SaveGame.snapshot(game)
	check(SaveGame.restore(game,JSON.parse_string(JSON.stringify(before))),"通知前JSON读档")
	flow.handle("rest_next")
	check(flow.messages.size()==2 and game.payroll.minute==2040 and game.payroll.pending.a==0,"次日十点两封通知，未计薪")
	flow.tick(); flow.tick()
	check(flow.messages.size()==2,"通知不重复")
	flow.selected="a"; flow.message_action(1)
	check(flow.applications.a.phase=="deferred","可暂缓")
	flow.ask_conditions()
	check(flow.messages.back().id=="a:conditions","追问条件留在消息中")
	flow.accept("a"); flow.accept("b")
	check(flow.reserved()=="a" and flow.applications.b.phase=="offered","只允许一份待报到")
	flow.report("a")
	check(game.career.employer=="","不到预约时间不建立雇佣")
	flow.handle("rest_next")
	game.payroll.advance(600,"")
	game.player.position=game.npc_for_role("a_hr").position+Vector3(0,0,1)
	flow.report("a")
	check(game.career.employer=="","错过接待时间不静默入职")
	flow.postpone("a"); flow.handle("rest_next"); flow.report("a")
	check(game.career.employer=="a" and flow.applications.a.phase=="reported","改约后现场报到才入职")
	game.payroll.advance(30,game.career.employer)
	check(game.payroll.pending.a==600,"只计入职后工资")
	var after: Dictionary=SaveGame.snapshot(game)
	check(SaveGame.restore(game,JSON.parse_string(JSON.stringify(after))),"v11工资消息与招聘状态可读档")
	var count: int=flow.messages.size()
	flow.tick()
	check(flow.messages.size()==count,"读档不重发")
	var legacy: Dictionary=after.duplicate(true)
	legacy.version=10; legacy.erase("recruitment")
	check(SaveGame.restore(game,legacy) and game.career.employer=="a" and flow.applications.a.phase=="reported","旧档在职保留，未入职面试资格迁移")
	check(flow.applications.b.phase=="offered","旧档已面试无需重试")
	game.panels.show_page("messages")
	check(paused and game.panels.page=="messages","消息页暂停")
	game.panels.back()
	game.queue_free()
	await process_frame
	print("RECRUITMENT_TEST failures=",failures)
	quit(failures)
